# MeetFlow environment. Copy to .env.local for development. Placeholders only - never commit real secrets.
# Production uses deploy/.env.production.example (see docs/ENVIRONMENT_VARIABLES.md).

# --- Core ---
APP_NAME=MeetFlow
APP_URL=http://localhost:3000
DATABASE_URL=postgres://meetflow:meetflow@localhost:54329/meetflow
REDIS_URL=redis://localhost:63799
# >= 32 chars. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
# base64 of 32 random bytes (AES-256-GCM for stored OAuth tokens). Generate: openssl rand -base64 32
ENCRYPTION_KEY=base64-32-byte-key-placeholder

# --- Calendar / video integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Email (set RESEND_API_KEY or SMTP_URL, e.g. smtp://user:pass@host:587) ---
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=MeetFlow <no-reply@example.com>

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability (Sentry initialises only when SENTRY_DSN is set) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Testing ---
# E2E_BASE_URL=http://localhost:3000   # point Playwright at an already-running server

# Notetaker bot (Recall.ai). Unset = no bot; the shared notes page still works.
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Days Recall keeps meeting recordings (audio/video) before deleting them. Transcript and notes are kept.
NOTETAKER_RETENTION_DAYS=30
# AI meeting summaries (Gemini). Unset = transcript only, no summary.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash
# Signs the shared-notes links. Must be identical on the web app and the worker. Falls back to BETTER_AUTH_SECRET when unset.
NOTES_SECRET=

# Zoho: the ONLY way to sign in, plus Zoho Calendar + Meeting (set ZOHO_DC to the Zoho account region: com, in, eu, com.au, jp, ca, sa, uk).
# Register BOTH redirect URIs on the Zoho client: <APP_URL>/api/auth/callback/zoho (sign-in) and <APP_URL>/api/integrations/zoho/callback (calendar).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=com
# Company email domains allowed to sign in (comma-separated). Required: unset = nobody new can sign in. Example: acme.com,acme.in
ALLOWED_EMAIL_DOMAINS=

# --- Optional ---
# CRON_SECRET=   # enables POST /api/integrations/sync (x-cron-secret header)
# UPLOAD_DIR=./storage/uploads   # avatars; needs a persistent volume in production
# API_RATE_LIMIT=120   # REST API requests per minute per key
