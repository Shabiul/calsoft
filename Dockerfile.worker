# syntax=docker/dockerfile:1.7
# MeetFlow worker image (BullMQ). Also used for the one-shot `migrate` service because it ships
# tsx, drizzle migrations and scripts/migrate.ts.
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --legacy-peer-deps

FROM node:${NODE_VERSION}-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json drizzle.config.ts ./
COPY drizzle ./drizzle
COPY scripts ./scripts
COPY src ./src
RUN addgroup -S -g 1001 app && adduser -S -u 1001 -G app app && chown -R app:app /app
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD pidof node >/dev/null || exit 1
CMD ["npx", "tsx", "src/worker/index.ts"]
